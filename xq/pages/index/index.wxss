/* index.wxss */
page {
  background-color: #F5E6D3;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx;
  height: 100vh;
  box-sizing: border-box;
}

.header {
  width: 100%;
  margin: 10rpx 0;
  text-align: center;
}

.turn-indicator {
  padding: 10rpx 30rpx;
  background: #fff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  display: inline-block;
}

.turn-text {
  font-size: 28rpx;
  font-weight: bold;
}

.turn-text.red-turn {
  color: #C0392B;
}

.turn-text.black-turn {
  color: #2C3E50;
}

.status-info {
  width: 100%;
  text-align: center;
  margin: 5rpx 0;
}

.game-status {
  font-size: 26rpx;
  color: #8B4513;
  font-weight: bold;
}

.board-container {
  flex: 1;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  min-height: 400rpx;
}

.board-canvas {
  width: 360px;
  height: 400px;
  display: block;
}

.controls {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 15rpx;
  margin: 10rpx 0;
}

.control-btn {
  flex: 1;
  max-width: 150rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #8B4513;
  color: white;
  font-size: 22rpx;
  border: none;
  border-radius: 6rpx;
  padding: 0 10rpx;
}

.control-btn:active {
  background: #6B3513;
}
