/* pages/sentences/sentences.wxss */
.container {
  padding: 20rpx;
}

.category-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 50rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid #E0E0E0;
  transition: all 0.3s;
}

.filter-item.active {
  background: #4A90E2;
  color: #FFFFFF;
  border-color: #4A90E2;
}

.sentence-list {
  padding-bottom: 20rpx;
}

.sentence-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.sentence-card:active {
  transform: scale(0.98);
}

.sentence-english {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.sentence-chinese {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.sentence-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sentence-category {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
}

.learned-status {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
}

.learned-status.learned {
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
}

/* 句型详情弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  z-index: 999;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 85%;
  max-height: 80%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  overflow-y: auto;
  transform: scale(0.8);
  transition: transform 0.3s;
}

.modal.show .modal-content {
  transform: scale(1);
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  margin-top: 24rpx;
}

.detail-label:first-child {
  margin-top: 0;
}

.detail-english {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.detail-chinese {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.detail-category {
  font-size: 26rpx;
  color: #4A90E2;
  background: rgba(74, 144, 226, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.mark-learned-btn,
.speak-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  margin-top: 24rpx;
  border: none;
}

.mark-learned-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
}

.speak-btn {
  background: #F5F5F5;
  color: #666;
}
