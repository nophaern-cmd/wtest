<!--pages/words/words.wxml-->
<view class="container">
  <view class="tabs">
    <view class="tab {{activeTab === 'basic' ? 'active' : ''}}" bindtap="switchTab" data-tab="basic">
      基础词汇
    </view>
    <view class="tab {{activeTab === 'phonics' ? 'active' : ''}}" bindtap="switchTab" data-tab="phonics">
      自然拼读
    </view>
  </view>

  <!-- 基础词汇 -->
  <view wx:if="{{activeTab === 'basic'}}" class="word-list">
    <view class="word-card" wx:for="{{basicWords}}" wx:key="english">
      <view class="word-actions">
        <view class="status-icon {{item.learned ? 'learned' : ''}}" bindtap="markAsLearnedDirect" data-word="{{item}}" catchtap>
          {{item.learned ? '✓' : '○'}}
        </view>
      </view>
      <view class="word-content" bindtap="showWordDetail" data-word="{{item}}">
        <view class="word-text">
          <text class="word-english">{{item.english}}</text>
          <text class="word-chinese"> - {{item.chinese}}</text>
        </view>
      </view>
      <view class="word-emoji" bindtap="quickSpeak" data-word="{{item}}" catchtap>{{item.emoji}}</view>
    </view>
  </view>

  <!-- 自然拼读 -->
  <view wx:if="{{activeTab === 'phonics'}}" class="phonics-list">
    <view class="letter-card" wx:for="{{phonicsData}}" wx:key="letter" bindtap="toggleLetter" data-letter="{{item.letter}}">
      <view class="letter-header">
        <view class="letter-icon">{{item.letter}}</view>
        <view class="letter-words-count">{{item.words.length}} 个词汇</view>
        <view class="expand-icon">{{item.expanded ? '▲' : '▼'}}</view>
      </view>
    <view class="letter-words" wx:if="{{item.expanded}}">
      <view class="word-item" wx:for="{{item.words}}" wx:for-item="word" wx:key="english">
        <view class="word-item-left" bindtap="showWordDetail" data-word="{{word}}" catchtap>
          <view class="word-emoji">{{word.emoji}}</view>
          <view class="word-content">
            <view class="word-english">{{word.english}}</view>
            <view class="word-chinese">{{word.chinese}}</view>
          </view>
        </view>
        <view class="word-item-speak" bindtap="quickSpeak" data-word="{{word}}">
          🔊
        </view>
      </view>
    </view>
    </view>
  </view>
</view>

<!-- 单词详情弹窗 -->
<view class="modal {{showDetail ? 'show' : ''}}" bindtap="hideWordDetail">
  <view class="modal-content" catchtap>
    <view class="modal-close" bindtap="hideWordDetail">✕</view>
    <view class="emoji-container">
      <view class="nav-icon prev-icon" bindtap="prevWord">◀</view>
      <view class="detail-emoji" bindtap="speakWord">{{currentWord.emoji}}</view>
      <view class="nav-icon next-icon" bindtap="nextWord">▶</view>
    </view>
    <view class="detail-english">{{currentWord.english}}</view>
    <view class="detail-chinese">{{currentWord.chinese}}</view>
    <button class="mark-learned-btn" bindtap="markAsLearned">
      {{currentWord.learned ? '已掌握 ✓' : '标记为已掌握'}}
    </button>
    <button class="speak-btn" bindtap="speakWord">🔊 朗读单词</button>
  </view>
</view>
