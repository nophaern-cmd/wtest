/* pages/privacy/privacy.wxss */
.privacy-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.privacy-header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: rotate 20s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.header-content {
  position: relative;
  text-align: center;
}

.privacy-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.privacy-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
}

.privacy-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.privacy-body {
  height: calc(100vh - 300rpx);
  padding: 20rpx;
}

.privacy-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #e9ecef;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-content {
  padding: 30rpx;
}

.section-content.highlight {
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.05) 0%, rgba(53, 122, 189, 0.05) 100%);
}

.content-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.content-item {
  margin-bottom: 25rpx;
}

.content-item:last-child {
  margin-bottom: 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.item-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
  padding-left: 10rpx;
}

.item-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 22rpx;
  border-radius: 4rpx;
}

.item-check {
  display: inline-block;
  font-size: 32rpx;
  margin-right: 15rpx;
  color: #4caf50;
}

.item-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.item-icon {
  display: inline-block;
  font-size: 28rpx;
  margin-right: 10rpx;
}

.content-item.important {
  background: #fff3e0;
  padding: 20rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #ff9800;
}

.content-item.important .item-text {
  color: #e65100;
}

.privacy-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.footer-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 40rpx;
  border: none;
}

.footer-btn::after {
  border: none;
}
