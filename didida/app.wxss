/* app.wxss */
page {
  background-color: #FFF5F0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 阶段差异化样式 */

/* 幼儿阶段样式 */
.kindergarten .card {
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 67, 0.2);
}

.kindergarten .btn-primary {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 36rpx;
}

.kindergarten .text-title {
  font-size: 64rpx;
}

.kindergarten .text-body {
  font-size: 36rpx;
}

/* 小学阶段样式 */
.primary .card {
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(84, 160, 255, 0.15);
}

.primary .btn-primary {
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
}

.primary .text-title {
  font-size: 48rpx;
}

.primary .text-body {
  font-size: 28rpx;
}

/* 中学阶段样式 */
.middle .card {
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(95, 39, 205, 0.1);
}

.middle .btn-primary {
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.middle .text-title {
  font-size: 36rpx;
}

.middle .text-body {
  font-size: 24rpx;
}

/* 通用组件 */
.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.btn-primary {
  background: linear-gradient(135deg, #FF9F43, #FFB875);
  color: white;
  border-radius: 50rpx;
  border: none;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-secondary {
  background: white;
  color: #FF9F43;
  border: 2rpx solid #FF9F43;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

.text-primary {
  color: #FF9F43;
}

.text-success {
  color: #1DD1A1;
}

.text-warning {
  color: #FAAD14;
}

.text-error {
  color: #FF6B6B;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.align-center {
  align-items: center;
}

.margin-top {
  margin-top: 20rpx;
}

.margin-bottom {
  margin-bottom: 20rpx;
}

.padding {
  padding: 20rpx;
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: bold;
}
