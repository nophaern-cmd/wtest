/* pages/stats/stats.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.back-btn {
  font-size: 32rpx;
  color: #666;
  margin-right: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.placeholder-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
}

.placeholder-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
