/* pages/mode-select/mode-select.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.header-back {
  display: flex;
  align-items: center;
  color: #666;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 40rpx;
  margin-right: 8rpx;
}

.header-title {
  flex: 1;
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-right: 60rpx; /* 平衡左侧返回按钮的宽度 */
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  background: white;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF9F43;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 模式列表 */
.mode-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.mode-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.mode-card:active {
  transform: scale(0.98);
}

.mode-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

.mode-1::before {
  background: linear-gradient(to bottom, #1DD1A1, #10AC84);
}

.mode-2::before {
  background: linear-gradient(to bottom, #5F27CD, #341F97);
}

.mode-3::before {
  background: linear-gradient(to bottom, #FF9F43, #EE5A24);
}

.mode-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background: #F5F5F5;
  border-radius: 50rpx;
  margin-right: 24rpx;
  font-size: 32rpx;
  gap: 4rpx;
}

.mode-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.mode-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.mode-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.mode-progress {
  background: linear-gradient(135deg, #FF9F43, #FFB875);
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  min-width: 80rpx;
  text-align: center;
}

/* 今日学习目标 */
.daily-goal {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.goal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.goal-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.goal-progress {
  font-size: 28rpx;
  color: #FF9F43;
  font-weight: bold;
}

.goal-bar {
  height: 12rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.goal-fill {
  height: 100%;
  background: linear-gradient(to right, #1DD1A1, #10AC84);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 阶段差异化样式 */

/* 幼儿阶段 */
.kindergarten .mode-card {
  border-radius: 32rpx;
  padding: 40rpx;
}

.kindergarten .mode-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  font-size: 36rpx;
}

.kindergarten .mode-name {
  font-size: 36rpx;
}

.kindergarten .stat-value {
  font-size: 48rpx;
}

/* 小学阶段 */
.primary .mode-card {
  border-radius: 20rpx;
}

.primary .mode-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 45rpx;
}

/* 中学阶段 */
.middle .mode-card {
  border-radius: 16rpx;
  padding: 24rpx;
}

.middle .mode-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.middle .mode-name {
  font-size: 28rpx;
}

.middle .mode-desc {
  font-size: 22rpx;
}
