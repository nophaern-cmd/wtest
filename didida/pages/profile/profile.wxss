/* pages/profile/profile.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #F5F5F5;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #FF9F43, #FFB875);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 67, 0.3);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.user-level {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 统计区域 */
.stats-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9F43;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 功能菜单 */
.menu-section {
  background: white;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #999;
}

/* 学习日历 */
.calendar-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.calendar-day {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.calendar-day.learned {
  background: linear-gradient(135deg, #1DD1A1, #10AC84);
}

.day-text {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.calendar-day.learned .day-text {
  color: white;
}

.date-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.calendar-day.learned .date-text {
  color: white;
}

/* 阶段差异化 */

/* 幼儿阶段 */
.kindergarten .stat-value {
  font-size: 56rpx;
}

.kindergarten .menu-text {
  font-size: 32rpx;
}

/* 小学阶段 */
.primary .stat-value {
  font-size: 48rpx;
}

/* 中学阶段 */
.middle .stat-value {
  font-size: 40rpx;
}

.middle .menu-text {
  font-size: 26rpx;
}
