.container {
  padding: 30rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
}

/* 联想类型网格 */
.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.type-item {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.type-item:active {
  transform: scale(0.98);
}

.type-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 15rpx;
}

.type-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.type-count {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 联想列表 */
.association-list {
  height: calc(100vh - 450rpx);
}

.association-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.association-item:active {
  transform: scale(0.98);
}

.assoc-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.assoc-info {
  flex: 1;
}

.assoc-word {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.assoc-meaning {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.assoc-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.assoc-arrow {
  font-size: 28rpx;
  color: #999;
}

/* 联想详情 */
.association-detail {
  padding-bottom: 50rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.back-btn {
  font-size: 26rpx;
  color: #4A90E2;
  padding: 10rpx 20rpx;
  border: 2rpx solid #4A90E2;
  border-radius: 20rpx;
}

.detail-type {
  font-size: 28rpx;
  color: #4A90E2;
  background: #F0F7FF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 单词展示 */
.word-display {
  text-align: center;
  background: linear-gradient(135deg, #4A90E2, #5BA3F5);
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 30rpx;
  color: white;
}

.word-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.word-english {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.word-phonetic {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 25rpx;
}

.audio-btn {
  width: 200rpx;
  height: 60rpx;
  background: white;
  color: #4A90E2;
  border: none;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
}

/* 记忆卡片 */
.memory-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.15);
}

.memory-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.memory-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90E2;
}

.memory-type {
  font-size: 24rpx;
  color: #666;
  background: #F5F5F5;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.memory-content {
  background: linear-gradient(135deg, #FFF9E6, #FFF3D6);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
}

.memory-association {
  display: block;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.memory-tip-section {
  background: #F0F7FF;
  border-radius: 16rpx;
  padding: 25rpx;
}

.tip-label {
  display: block;
  font-size: 24rpx;
  color: #4A90E2;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.tip-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 相关单词 */
.related-words {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.related-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.related-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.related-item {
  background: linear-gradient(135deg, #F0F7FF, #E6F3FF);
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.related-item:active {
  transform: scale(0.95);
}

.related-word {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: bold;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

.prev-btn,
.next-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: white;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
}

.prev-btn[disabled],
.next-btn[disabled] {
  opacity: 0.3;
}

.mark-known {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: linear-gradient(135deg, #52C41A, #73D13D);
  color: white;
  border: none;
  font-weight: bold;
}
