.container {
  padding: 30rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* 阶段选择 */
.level-selector {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.level-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.level-item.active {
  background: #F0F7FF;
}

.level-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.level-name {
  font-size: 26rpx;
  color: #666;
}

.level-item.active .level-name {
  color: #4A90E2;
  font-weight: bold;
}

/* 联想类型网格 */
.type-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.type-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.type-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.type-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.type-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.type-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.type-count {
  display: block;
  font-size: 22rpx;
  color: #4A90E2;
  background: #F0F7FF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  width: fit-content;
}

/* 联想列表 */
.list-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.back-btn {
  font-size: 26rpx;
  color: #4A90E2;
  padding: 10rpx 0;
}

.association-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.association-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.association-item:active {
  background: #F0F0F0;
}

.item-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-word {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.item-phonetic {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.item-meaning {
  font-size: 26rpx;
  color: #666;
}

.item-arrow {
  font-size: 32rpx;
  color: #CCC;
}

/* 联想详情 */
.detail-section {
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.detail-type {
  font-size: 26rpx;
  color: #4A90E2;
  background: #F0F7FF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 单词卡片 */
.word-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.word-image {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.word-info {
  text-align: center;
  margin-bottom: 24rpx;
}

.word-english {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.word-phonetic {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.word-meaning {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.audio-button {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
}

.audio-icon {
  font-size: 32rpx;
}

.audio-text {
  font-size: 26rpx;
  color: white;
}

/* 联想说明和记忆提示 */
.association-box,
.memory-tip {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.box-title,
.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.box-content,
.tip-content {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.memory-tip {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.tip-title {
  color: #d35400;
}

.tip-content {
  color: #8d4004;
}

/* 相关单词 */
.related-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.related-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.related-words {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.related-word {
  padding: 12rpx 24rpx;
  background: #F0F7FF;
  color: #4A90E2;
  border-radius: 30rpx;
  font-size: 26rpx;
  transition: all 0.3s ease;
}

.related-word:active {
  background: #4A90E2;
  color: white;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-collect,
.btn-next {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-collect {
  background: white;
  color: #FFD700;
  border: 2rpx solid #FFD700;
}

.btn-next {
  background: linear-gradient(135deg, #4A90E2, #5BA3F5);
  color: white;
}
