/* 国学朗读页面 */
.guoxue-container {
  height: 100vh;
  background-color: #FDF5E6;
  display: flex;
  flex-direction: column;
}

/* 滑动区域 */
.content-swiper {
  flex: 1;
  height: 100%;
}

/* 内容区域 */
.content-area {
  height: 100%;
  padding: 30rpx;
}

/* 标题区域 */
.title-section {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx dashed #DEB887;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2C1810;
  margin-bottom: 16rpx;
}

.author {
  display: block;
  font-size: 26rpx;
  color: #888;
}

/* 正文区域 */
.content-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(139, 69, 19, 0.1);
}

.content-text {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 2.2;
  color: #2C1810;
  white-space: pre-wrap;
  letter-spacing: 5rpx;
}

/* 解释区域 */
.explanation-section {
  background-color: #FFFAF0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #DAA520;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #B8860B;
  margin-bottom: 16rpx;
}

.explanation-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #5C4033;
}

/* 注释区域 */
.notes-section {
  background-color: #F5F5DC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #8B4513;
}

.notes-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #5C4033;
}

/* 故事区域 */
.stories-section {
  background-color: #FFF8DC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #CD853F;
}

.story-item {
  margin-bottom: 20rpx;
}

.story-item:last-child {
  margin-bottom: 0;
}

.story-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 12rpx;
}

.story-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: #5C4033;
  white-space: pre-wrap;
}

/* 底部占位 */
.bottom-placeholder {
  height: 180rpx;
}

/* 底部工具栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #FFFFFF;
  border-top: 1rpx solid #DEB887;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.footer-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: 40rpx;
}

.btn-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #B8860B;
}

.countdown-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #FF6B6B;
  margin-top: 4rpx;
}
