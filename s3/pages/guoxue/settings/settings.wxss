.settings-container {
  min-height: 100vh;
  background-color: #FDF5E6;
  padding: 20rpx;
}

.settings-section {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.mode-buttons {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mode-buttons:last-child {
  margin-bottom: 0;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.mode-btn.active {
  background-color: #B8860B;
  color: #FFFFFF;
}

.countdown-display {
  text-align: center;
  padding: 20rpx;
  margin-top: 16rpx;
  background-color: #FFF8DC;
  border-radius: 8rpx;
}

.countdown-display text {
  font-size: 30rpx;
  font-weight: bold;
  color: #B8860B;
}
