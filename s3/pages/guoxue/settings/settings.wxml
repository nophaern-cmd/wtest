<view class="settings-container">
  <!-- 显示设置 -->
  <view class="settings-section">
    <text class="section-label">显示设置</text>
    <view class="mode-buttons">
      <view class="mode-btn {{settings.showExplanation ? 'active' : ''}}" 
            data-key="showExplanation" bindtap="toggleSetting">解释</view>
      <view class="mode-btn {{settings.showNotes ? 'active' : ''}}" 
            data-key="showNotes" bindtap="toggleSetting">注释</view>
      <view class="mode-btn {{settings.showStories ? 'active' : ''}}" 
            data-key="showStories" bindtap="toggleSetting">故事</view>
    </view>
  </view>

  <!-- 播放内容 -->
  <view class="settings-section">
    <text class="section-label">播放内容</text>
    <view class="mode-buttons">
      <view class="mode-btn {{settings.playContent ? 'active' : ''}}" 
            data-key="playContent" bindtap="toggleSetting">正文</view>
      <view class="mode-btn {{settings.playExplanation ? 'active' : ''}}" 
            data-key="playExplanation" bindtap="toggleSetting">解释</view>
      <view class="mode-btn {{settings.playNotes ? 'active' : ''}}" 
            data-key="playNotes" bindtap="toggleSetting">注解</view>
      <view class="mode-btn {{settings.playStories ? 'active' : ''}}" 
            data-key="playStories" bindtap="toggleSetting">故事</view>
    </view>
  </view>

  <!-- 播放模式 -->
  <view class="settings-section">
    <text class="section-label">播放模式</text>
    <view class="mode-buttons">
      <view class="mode-btn {{settings.playMode === 'single' ? 'active' : ''}}" 
            data-mode="single" bindtap="setPlayMode">单次</view>
      <view class="mode-btn {{settings.playMode === 'chapterLoop' ? 'active' : ''}}" 
            data-mode="chapterLoop" bindtap="setPlayMode">单章循环</view>
    </view>
    <view class="mode-buttons">
      <view class="mode-btn {{settings.playMode === 'allOnce' ? 'active' : ''}}" 
            data-mode="allOnce" bindtap="setPlayMode">全章一次</view>
      <view class="mode-btn {{settings.playMode === 'allLoop' ? 'active' : ''}}" 
            data-mode="allLoop" bindtap="setPlayMode">全章循环</view>
    </view>
  </view>

  <!-- 定时停止 -->
  <view class="settings-section">
    <text class="section-label">定时停止</text>
    <view class="mode-buttons">
      <view class="mode-btn {{settings.autoStop === 0 ? 'active' : ''}}" 
            data-minutes="0" bindtap="setAutoStop">关</view>
      <view class="mode-btn {{settings.autoStop === 10 ? 'active' : ''}}" 
            data-minutes="10" bindtap="setAutoStop">10分</view>
      <view class="mode-btn {{settings.autoStop === 20 ? 'active' : ''}}" 
            data-minutes="20" bindtap="setAutoStop">20分</view>
      <view class="mode-btn {{settings.autoStop === 30 ? 'active' : ''}}" 
            data-minutes="30" bindtap="setAutoStop">30分</view>
      <view class="mode-btn {{settings.autoStop === 60 ? 'active' : ''}}" 
            data-minutes="60" bindtap="setAutoStop">1时</view>
    </view>
    <view class="countdown-display" wx:if="{{countdown > 0}}">
      <text>⏱ 剩余：{{countdownText}}</text>
    </view>
  </view>

  <!-- 正在下载的任务 -->
  <view class="settings-section" wx:if="{{downloadingCount > 0}}">
    <view class="section-header">
      <text class="section-label">正在下载 ({{downloadingCount}})</text>
      <text class="cancel-all-btn" bindtap="cancelAllDownloads">全部取消</text>
    </view>
    <view class="downloading-list">
      <view class="downloading-item" wx:for="{{downloadingTasks}}" wx:key="fileName">
        <view class="downloading-info">
          <text class="downloading-name">{{item.fileName}}</text>
          <text class="downloading-status">下载中...</text>
        </view>
        <text class="cancel-btn" data-file="{{item.fileName}}" bindtap="cancelDownloadTask">取消</text>
      </view>
    </view>
  </view>

  <!-- 音频缓存管理 -->
  <view class="settings-section cache-section">
    <view class="section-header" bindtap="toggleCacheDetail">
      <text class="section-label">音频缓存</text>
      <text class="cache-size">{{cacheSizeText}}</text>
      <text class="toggle-icon">{{showCacheDetail ? '▼' : '▶'}}</text>
    </view>
    
    <view class="cache-actions">
      <button class="cache-btn" bindtap="downloadCurrentChapter">下载当前章节</button>
      <button class="cache-btn" bindtap="downloadAllChapters">下载全部</button>
      <button class="cache-btn danger" bindtap="clearCache" disabled="{{cacheSize === 0}}">清除缓存</button>
    </view>
    
    <!-- 缓存详情 -->
    <view class="cache-detail" wx:if="{{showCacheDetail && cacheList.length > 0}}">
      <view class="cache-item" wx:for="{{cacheList}}" wx:key="fileName">
        <view class="cache-info">
          <text class="cache-name">{{item.fileName}}</text>
          <text class="cache-meta">{{item.sizeText}}</text>
        </view>
        <text class="cache-delete" data-file="{{item.fileName}}" bindtap="removeCacheItem">×</text>
      </view>
      <view class="cache-more" wx:if="{{cacheList.length >= 20}}">
        <text>仅显示最近 20 条</text>
      </view>
    </view>
    
    <view class="cache-empty" wx:if="{{showCacheDetail && cacheList.length === 0}}">
      <text>暂无缓存</text>
    </view>
  </view>
</view>
