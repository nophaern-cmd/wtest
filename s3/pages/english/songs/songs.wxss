/* pages/songs/songs.wxss */
.container {
  padding: 20rpx;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  font-weight: bold;
}

.songs-list {
  margin-bottom: 30rpx;
}

.song-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
  border: 3rpx solid transparent;
}

.song-card.playing {
  border-color: #4A90E2;
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
}

.song-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.song-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
  animation: rotate 3s linear infinite;
}

.song-card.playing .song-icon {
  animation: bounce 0.6s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.song-info {
  flex: 1;
}

.song-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.song-type {
  font-size: 22rpx;
  color: #999;
}

.play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s;
}

.play-btn:active {
  transform: scale(0.9);
}

.play-icon,
.pause-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

.song-card.playing .play-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.tip-card {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  color: #FFFFFF;
}

.tip-title {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.tip-content {
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.95;
}

/* 儿歌详情弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  z-index: 999;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 85%;
  max-height: 85%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  overflow-y: auto;
  transform: scale(0.8);
  transition: transform 0.3s;
}

.modal.show .modal-content {
  transform: scale(1);
}

.song-icon-large {
  font-size: 120rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
}

.detail-type {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 16rpx;
  padding: 8rpx 16rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  display: inline-block;
  margin-left: 50%;
  transform: translateX(-50%);
}

.playing-status {
  font-size: 24rpx;
  color: #4A90E2;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 12rpx;
  background: rgba(74, 144, 226, 0.1);
  border-radius: 16rpx;
}

.lyrics-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #F0F0F0;
}

.lyrics-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.lyrics-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  min-height: 200rpx;
}

.favorite-btn,
.watch-video-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  margin-top: 24rpx;
  border: none;
}

.favorite-btn {
  background: #F5F5F5;
  color: #666;
}

.favorite-btn.favorited {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #FFFFFF;
}

.play-song-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

.watch-video-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
}
