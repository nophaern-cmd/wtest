/* pages/quiz/quiz.wxss */
.container {
  padding: 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.quiz-types {
  margin-bottom: 40rpx;
}

.quiz-type-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.quiz-type-card:active {
  transform: scale(0.98);
}

.quiz-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.quiz-type-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.quiz-type-desc {
  font-size: 24rpx;
  color: #999;
}

.stats-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stats-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 测试进行中 */
.quiz-container {
  padding: 20rpx;
}

.quiz-progress {
  margin-bottom: 30rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.question-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.question-icon {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.option-item.selected {
  border-color: #4A90E2;
  background: rgba(74, 144, 226, 0.1);
}

.option-item.correct {
  border-color: #4CAF50;
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.15) 0%, rgba(76, 175, 80, 0.1) 100%);
  border-width: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.option-item.wrong {
  border-color: #F44336;
  background: linear-gradient(135deg, rgba(244, 67, 54, 0.15) 0%, rgba(244, 67, 54, 0.1) 100%);
  border-width: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(244, 67, 54, 0.3);
}

.option-label {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-emoji {
  font-size: 72rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-text {
  flex: 1;
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.option-status {
  font-size: 48rpx;
  font-weight: bold;
  margin-left: 24rpx;
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-item.correct .option-status {
  background: #4CAF50;
  color: #FFFFFF;
}

.option-item.wrong .option-status {
  background: #F44336;
  color: #FFFFFF;
}

.next-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  border: none;
}

/* 测试结果 */
.result-container {
  padding: 40rpx;
  text-align: center;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.result-score {
  font-size: 80rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.score-breakdown {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

.breakdown-item {
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 24rpx 40rpx;
}

.breakdown-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.breakdown-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A90E2;
}

.restart-btn,
.home-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  margin-bottom: 16rpx;
  border: none;
}

.restart-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
}

.home-btn {
  background: #F5F5F5;
  color: #666;
}
