/* pages/index/index.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #F8F9FF 0%, #FFFFFF 100%);
}

/* Loading */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #E0E0E0;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 顶部欢迎区域 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 40rpx;
}

.header-decoration {
  font-size: 48rpx;
  animation: float 3s ease-in-out infinite;
}

.header-decoration:last-child {
  animation-delay: 1.5s;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.welcome-section {
  text-align: center;
  flex: 1;
}

.greeting {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.app-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #FFFFFF;
}

/* 分区通用样式 */
.progress-section,
.quick-access-section,
.menu-section {
  padding: 0 30rpx 40rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 学习进度卡片 */
.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
}

.stat-icon-wrapper.words {
  background: linear-gradient(135deg, #FFE5E5 0%, #FFD4D4 100%);
}

.stat-icon-wrapper.sentences {
  background: linear-gradient(135deg, #E5F4FF 0%, #D4EAFF 100%);
}

.stat-icon-wrapper.quiz {
  background: linear-gradient(135deg, #FFF5E5 0%, #FFE9D4 100%);
}

.stat-info {
  flex: 1;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 快捷入口 */
.quick-access-grid {
  display: flex;
  gap: 16rpx;
}

.quick-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  position: relative;
  z-index: 1;
}

.quick-card.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.quick-card.accent {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.3);
}

.quick-card:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.quick-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.quick-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.quick-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #FFFFFF;
}

/* 功能菜单 */
.menu-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.menu-card:active {
  transform: scale(0.98);
  background: #F8F9FF;
}

.menu-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon-wrapper.phonics {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.menu-icon-wrapper.songs {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.menu-icon-wrapper.stories {
  background: linear-gradient(135deg, #E1F5FE 0%, #B3E5FC 100%);
}

.menu-icon-wrapper.quiz-menu {
  background: linear-gradient(135deg, #FCE4EC 0%, #F8BBD0 100%);
}

.menu-icon {
  font-size: 32rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* 每日提示 */
.daily-tip-card {
  margin: 0 30rpx 40rpx;
  background: linear-gradient(135deg, #FFA726 0%, #FB8C00 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 167, 38, 0.3);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.tip-content {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.6;
}
