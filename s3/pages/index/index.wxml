<!-- 国学朗读工具首页 -->
<view class="hall-container">
  <!-- 顶部欢迎区域 -->
  <view class="welcome-section">
    <view class="welcome-bg"></view>
    <view class="welcome-content">
      <text class="welcome-title">📖 国学朗读</text>
      <text class="welcome-subtitle">经典诵读 · 启迪智慧</text>
    </view>
  </view>

  <!-- 主要入口 - 国学朗读 -->
  <view class="main-entry">
    <view class="main-card guoxue-main" bindtap="navigateToGuoxue">
      <view class="main-icon-wrapper">
        <text class="main-icon">📜</text>
      </view>
      <view class="main-info">
        <text class="main-title">国学朗读</text>
        <text class="main-desc">传承经典，启迪智慧</text>
        <view class="main-stats">
          <text class="stats-item">📜 {{sanzijingCount}} 篇三字经</text>
          <text class="stats-item">🎋 {{poemsCount}} 首古诗词</text>
        </view>
      </view>
      <view class="main-enter">
        <text class="enter-text">开始朗读</text>
        <text class="enter-icon">→</text>
      </view>
    </view>
  </view>

  <!-- 其他入口 -->
  <view class="other-section">
    <text class="section-title">更多内容</text>
    <view class="other-card english-card" bindtap="navigateToEnglish">
      <view class="other-icon-wrapper">
        <text class="other-icon">📚</text>
      </view>
      <view class="other-info">
        <text class="other-title">英语朗读</text>
        <text class="other-desc">英语单词、句型朗读</text>
      </view>
      <view class="other-enter">
        <text class="enter-icon">→</text>
      </view>
    </view>
  </view>

  <!-- 快捷功能 -->
  <view class="quick-section">
    <view class="quick-item" bindtap="quickStart" data-type="sanzijing">
      <text class="quick-icon">📜</text>
      <text class="quick-text">三字经</text>
    </view>
    <view class="quick-item" bindtap="quickStart" data-type="poems">
      <text class="quick-icon">🎋</text>
      <text class="quick-text">古诗词</text>
    </view>
    <view class="quick-item" bindtap="quickStart" data-type="random">
      <text class="quick-icon">🎲</text>
      <text class="quick-text">随机朗读</text>
    </view>
  </view>
</view>
