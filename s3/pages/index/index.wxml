<view class="container">
  <view class="header">
    <text class="title">国学学习</text>
    <text class="subtitle">传承经典 启迪智慧</text>
  </view>

  <view class="features">
    <view class="feature-card" wx:for="{{features}}" wx:key="id" 
          bindtap="goToLearn" data-category="{{item.id}}">
      <view class="feature-icon">{{item.icon}}</view>
      <view class="feature-info">
        <text class="feature-title">{{item.title}}</text>
        <text class="feature-desc">{{item.desc}}</text>
      </view>
      <view class="feature-arrow">›</view>
    </view>
  </view>

  <view class="start-btn" bindtap="goToAllLearn">
    <text class="start-text">开始学习</text>
  </view>

  <view class="footer">
    <text class="footer-text">让国学经典陪伴孩子成长</text>
  </view>
</view>