/* 国学朗读工具首页样式 */
.hall-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 40rpx;
}

/* 欢迎区域 */
.welcome-section {
  position: relative;
  padding: 50rpx 40rpx 60rpx;
  text-align: center;
}

.welcome-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
}

.welcome-content {
  position: relative;
  z-index: 1;
}

.welcome-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.welcome-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

/* 主要入口 - 国学朗读 */
.main-entry {
  padding: 0 30rpx;
  margin-top: -10rpx;
}

.main-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8F0 100%);
  border-radius: 24rpx;
  padding: 40rpx 35rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(139, 90, 43, 0.25);
  position: relative;
  overflow: hidden;
}

.main-card:active {
  transform: scale(0.98);
}

.guoxue-main::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 10rpx;
  height: 100%;
  background: linear-gradient(180deg, #8B5A2B 0%, #D4A76A 100%);
}

.main-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE4C4 100%);
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 90, 43, 0.15);
}

.main-icon {
  font-size: 70rpx;
}

.main-info {
  flex: 1;
}

.main-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #5D3A1A;
  margin-bottom: 10rpx;
}

.main-desc {
  display: block;
  font-size: 26rpx;
  color: #8B7355;
  margin-bottom: 14rpx;
}

.main-stats {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.stats-item {
  font-size: 24rpx;
  color: #A67C52;
  background-color: #FFF5E6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.main-enter {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  padding: 16rpx 24rpx;
  border-radius: 30rpx;
}

.enter-text {
  font-size: 24rpx;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.enter-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 其他入口 */
.other-section {
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  display: block;
}

.other-card {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx 25rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.other-card:active {
  transform: scale(0.98);
}

.other-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #E8F4FD 0%, #D1E9FC 100%);
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.other-icon {
  font-size: 48rpx;
}

.other-info {
  flex: 1;
}

.other-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 6rpx;
}

.other-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.other-enter {
  width: 50rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #5BA3F5 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 快捷功能 */
.quick-section {
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.quick-item {
  flex: 1;
  max-width: 200rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item:active {
  background-color: rgba(255, 255, 255, 0.3);
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.quick-text {
  font-size: 24rpx;
  color: #FFFFFF;
}
