/* 学习大厅首页样式 */
.hall-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 40rpx;
}

/* 欢迎区域 */
.welcome-section {
  position: relative;
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
}

.welcome-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
}

.welcome-content {
  position: relative;
  z-index: 1;
}

.welcome-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

.welcome-subtitle {
  display: block;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

/* 学习模块区域 */
.modules-section {
  padding: 0 30rpx;
  margin-top: -20rpx;
}

.module-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 35rpx 30rpx;
  margin-bottom: 25rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.module-card:active {
  transform: scale(0.98);
}

.english-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, #4A90E2 0%, #5BA3F5 100%);
}

.guoxue-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, #8B5A2B 0%, #A67C52 100%);
}

.module-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 25rpx;
}

.module-icon {
  font-size: 60rpx;
}

.module-info {
  flex: 1;
}

.module-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.module-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.module-stats {
  display: flex;
  gap: 20rpx;
}

.stats-item {
  font-size: 24rpx;
  color: #666666;
  background-color: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.module-enter {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.enter-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}


