.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #fdf6e3 0%, #f5e6c8 100%);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  text-align: center;
  padding: 60rpx 0 50rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #8B5A2B;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #a67c52;
}

.features {
  flex: 1;
  padding: 20rpx 0;
}

.feature-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(139, 90, 43, 0.12);
  transition: all 0.3s ease;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(139, 90, 43, 0.15);
}

.feature-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #faf6f0 0%, #f5e6c8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #5a3d22;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #a67c52;
}

.feature-arrow {
  font-size: 44rpx;
  color: #c9a87c;
  font-weight: bold;
}

.start-btn {
  background: linear-gradient(135deg, #8B5A2B 0%, #a67c52 100%);
  border-radius: 50rpx;
  padding: 30rpx 0;
  text-align: center;
  margin: 30rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(139, 90, 43, 0.3);
}

.start-btn:active {
  transform: scale(0.98);
}

.start-text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.footer {
  text-align: center;
  padding: 30rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #c9a87c;
}