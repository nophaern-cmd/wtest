.container {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #fdf6e3 0%, #f5e6c8 100%);
}

.top-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.1);
  gap: 12rpx;
}

.settings-btn {
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #8B5A2B;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.icon-btn.disabled {
  background: #ccc;
  opacity: 0.5;
}

.icon-btn.playing {
  background: #e74c3c;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.icon-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

/* 设置弹窗遮罩 */
.settings-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 100;
}

.settings-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 设置面板 */
.settings-panel {
  position: fixed;
  top: 0;
  right: -80%;
  width: 80%;
  height: 100%;
  background: #fff;
  z-index: 101;
  transition: right 0.3s ease;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.settings-panel.show {
  right: 0;
}

.settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e8dcc8;
}

.settings-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B5A2B;
}

.settings-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.settings-section {
  margin-bottom: 30rpx;
  flex-shrink: 0;
}

.settings-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.settings-item-text {
  font-size: 30rpx;
  color: #333;
}

/* 开关样式 */
.switch {
  width: 100rpx;
  height: 56rpx;
  background: #ccc;
  border-radius: 28rpx;
  position: relative;
  transition: background 0.3s ease;
}

.switch.on {
  background: #8B5A2B;
}

.switch-handle {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
  transition: left 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.switch.on .switch-handle {
  left: 48rpx;
}

.category-nav {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

/* 目录样式 */
.catalog-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  margin-bottom: 0;
}

.catalog-list {
  height: 60vh;
  border: 1rpx solid #e8dcc8;
  border-radius: 12rpx;
  background: #faf6f0;
}

.catalog-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #e8dcc8;
  transition: all 0.2s ease;
}

.catalog-item:last-child {
  border-bottom: none;
}

.catalog-item.active {
  background: #8B5A2B;
}

.catalog-item.active .catalog-index,
.catalog-item.active .catalog-title,
.catalog-item.active .catalog-author {
  color: #fff;
}

.catalog-index {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #e8dcc8;
  border-radius: 50%;
  font-size: 24rpx;
  color: #8B5A2B;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.catalog-item.active .catalog-index {
  background: rgba(255, 255, 255, 0.3);
}

.catalog-title {
  flex: 1;
  font-size: 30rpx;
  color: #5a3d22;
  font-weight: 500;
}

.catalog-author {
  font-size: 24rpx;
  color: #a67c52;
  margin-left: 16rpx;
}

.category-btn {
  padding: 20rpx 60rpx;
  background: #e8dcc8;
  border-radius: 40rpx;
  transition: all 0.3s ease;
}

.category-btn.active {
  background: #8B5A2B;
}

.category-text {
  font-size: 28rpx;
  color: #5a3d22;
  font-weight: 500;
}

.category-btn.active .category-text {
  color: #fff;
}

.lesson-header {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.toggle-btn {
  padding: 18rpx 50rpx;
  background: #e8dcc8;
  border-radius: 40rpx;
  transition: all 0.3s ease;
}

.toggle-btn.active {
  background: #8B5A2B;
}

.toggle-text {
  font-size: 28rpx;
  color: #5a3d22;
  font-weight: 500;
}

.toggle-btn.active .toggle-text {
  color: #fff;
}


.lesson-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B5A2B;
  margin-bottom: 8rpx;
}

.lesson-author {
  font-size: 26rpx;
  color: #a67c52;
}

.lesson-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.1);
}

.content-box {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.content-group {
  padding: 24rpx;
  background: linear-gradient(135deg, #faf6f0 0%, #fff 100%);
  border-radius: 12rpx;
  border: 2rpx solid #e8dcc8;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.content-row {
  display: flex;
  gap: 20rpx;
}

.content-line {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 10rpx;
  border-left: 4rpx solid #8B5A2B;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.main-text {
  font-size: 32rpx;
  color: #5a3d22;
  font-weight: 600;
  line-height: 1.5;
}

.note-text {
  font-size: 26rpx;
  color: #7a6650;
  line-height: 1.6;
  padding: 10rpx 14rpx;
  background: #fff8f0;
  border-radius: 8rpx;
  border-left: 4rpx solid #c9a87c;
  transition: all 0.3s ease;
}

.note-text.hidden {
  display: none;
}

.lesson-explanation {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.1);
}

.explanation-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #8B5A2B;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.explanation-text {
  font-size: 28rpx;
  color: #5a4a3a;
  line-height: 1.8;
  text-align: justify;
}

.progress {
  margin-top: 24rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.1);
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #8B5A2B;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.progress-bar {
  height: 12rpx;
  background: #e0d5c8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #8B5A2B 0%, #a67c52 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
