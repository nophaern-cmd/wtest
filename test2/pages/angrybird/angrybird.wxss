/* pages/angrybird/angrybird.wxss */
.angrybird-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #87CEEB 0%, #4682B4 50%, #2F4F4F 100%);
  display: flex;
  flex-direction: column;
}

/* 开始界面 */
.game-start {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.start-content {
  width: 100%;
  max-width: 600rpx;
  text-align: center;
}

.game-title {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 2rpx 4rpx 8rpx rgba(0, 0, 0, 0.3);
}

.game-desc {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
  text-shadow: 1rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.game-info {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  backdrop-filter: blur(10rpx);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.info-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.rules {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  text-align: left;
  backdrop-filter: blur(10rpx);
}

.rules-title {
  display: block;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.rule-item {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 2;
}

.start-btn {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: white;
  border: none;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.4);
}

.start-btn:active {
  transform: scale(0.95);
}

/* 游戏进行中 */
.game-playing {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  position: relative;
}

.game-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 障碍物 */
.obstacle {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #8B4513, #A0522D);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  border: 4rpx solid #654321;
}

.obstacle.hit {
  animation: shake 0.5s ease-in-out;
}

.obstacle-emoji {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.obstacle-health {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

/* 答题区 */
.question-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx;
  margin-top: 200rpx;
}

.question-box {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.question-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 16rpx;
  text-align: center;
}

.question-hint {
  display: block;
  font-size: 26rpx;
  color: #7F8C8D;
  text-align: center;
}

.options-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.option-bird {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s;
  border: 3rpx solid transparent;
}

.option-bird:active {
  transform: scale(0.95);
}

.option-bird.selected {
  background: #FFF9C4;
  border-color: #FBC02D;
}

.option-bird.correct {
  background: #C8E6C9;
  border-color: #4CAF50;
}

.option-bird.wrong {
  background: #FFCDD2;
  border-color: #F44336;
}

.bird-emoji {
  font-size: 48rpx;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  margin-top: 20rpx;
  backdrop-filter: blur(10rpx);
}

.score-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFD700;
}

.combo-badge {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 600;
  animation: pop 0.5s ease-in-out;
}

.round-display {
  font-size: 32rpx;
  color: white;
  font-weight: 600;
}

.lives-display {
  display: flex;
  gap: 8rpx;
}

.life {
  font-size: 28rpx;
  transition: all 0.3s;
}

.life.lost {
  opacity: 0.3;
  filter: grayscale(1);
}

/* 投射物动画 */
.projectile {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  background: radial-gradient(circle, #FFD700, #FFA500);
  border-radius: 50%;
  box-shadow: 0 0 12rpx #FFD700;
  z-index: 10;
}

/* 结果反馈 */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.result-content {
  background: white;
  border-radius: 24rpx;
  padding: 48rpx;
  text-align: center;
  min-width: 400rpx;
  animation: slideIn 0.3s ease-out;
}

.result-content.correct {
  border: 4rpx solid #4CAF50;
}

.result-content.wrong {
  border: 4rpx solid #F44336;
}

.result-emoji {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.result-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.result-score {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.result-content.correct .result-score {
  color: #4CAF50;
}

.result-content.wrong .result-score {
  color: #F44336;
}

/* 游戏结束 */
.game-over {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.over-content {
  width: 90%;
  max-width: 500rpx;
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.over-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.result-stats {
  margin-bottom: 40rpx;
}

.stat-box {
  padding: 32rpx;
  background: linear-gradient(135deg, #FF6B6B, #EE5A5A);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.stat-box .stat-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.stat-box .stat-value {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: white;
}

.stat-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.stat-item .stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stat-item .stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.stat-value.correct {
  color: #4CAF50;
}

.stat-value.wrong {
  color: #F44336;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.restart-btn, .home-btn {
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.restart-btn {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  color: white;
}

.home-btn {
  background: #f5f5f5;
  color: #333;
}

.restart-btn:active, .home-btn:active {
  transform: scale(0.98);
}

@keyframes shake {
  0%, 100% { transform: translateX(0) rotate(0); }
  25% { transform: translateX(-10rpx) rotate(-5deg); }
  75% { transform: translateX(10rpx) rotate(5deg); }
}

@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

@keyframes slideIn {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
