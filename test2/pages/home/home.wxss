/* pages/home/home.wxss */
.home-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fbff 0%, #f5f5f5 100%);
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  padding: 40rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 32rpx;
}

.welcome {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-mini {
  display: flex;
  gap: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 通用区块 */
.section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 学科选择 */
.subject-scroll {
  white-space: nowrap;
}

.subject-list {
  display: flex;
  gap: 20rpx;
}

.subject-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
  min-width: 120rpx;
}

.subject-item.active {
  background: #4A90E2;
  transform: scale(1.05);
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 226, 0.4);
}

.subject-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.subject-name {
  font-size: 28rpx;
  color: #666;
}

.subject-item.active .subject-name {
  color: white;
}

/* 游戏网格 */
.game-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.game-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  transition: all 0.3s;
}

.game-card:not(.disabled) {
  cursor: pointer;
}

.game-card:not(.disabled):active {
  transform: scale(0.95);
}

.game-card.disabled {
  opacity: 0.4;
  filter: grayscale(1);
  pointer-events: none;
}

.game-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.game-info {
  display: flex;
  flex-direction: column;
}

.game-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.game-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 32rpx;
  color: #4A90E2;
}

/* 推荐卡片 */
.recommend-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.recommend-item:active {
  transform: scale(0.98);
}

.recommend-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.recommend-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.recommend-desc {
  font-size: 24rpx;
  color: #999;
}

.recommend-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: white;
  font-size: 28rpx;
  border-radius: 24rpx;
}

/* 难度选择 */
.difficulty-selector {
  display: flex;
  gap: 20rpx;
}

.difficulty-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 20rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.difficulty-item.active {
  border-color: #4A90E2;
  background: #E6F7FF;
}

.difficulty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.difficulty-name {
  font-size: 28rpx;
  color: #666;
}

.difficulty-item.active .difficulty-name {
  color: #4A90E2;
  font-weight: 600;
}
