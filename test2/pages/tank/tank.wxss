/* pages/tank/tank.wxss */
.tank-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: column;
}

/* 开始界面 */
.game-start {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.start-content {
  width: 100%;
  max-width: 600rpx;
  text-align: center;
}

.game-title {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 0 20rpx rgba(0, 255, 255, 0.5);
}

.game-desc {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
}

.game-info {
  background: rgba(0, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.3);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.info-value {
  font-size: 28rpx;
  color: #00ffff;
  font-weight: 500;
}

.rules {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  text-align: left;
}

.rules-title {
  display: block;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.rule-item {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 2;
}

.start-btn {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  color: white;
  border: none;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
}

.start-btn:active {
  transform: scale(0.95);
}

/* 游戏进行中 */
.game-playing {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 战场区域 */
.battlefield {
  height: 50vh;
  position: relative;
  background: linear-gradient(180deg, #0a0a1a 0%, #1a1a2e 100%);
  border-bottom: 4rpx solid #00ffff;
  overflow: hidden;
}

/* 堡垒 */
.fortress {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fortress-emoji {
  font-size: 120rpx;
  filter: drop-shadow(0 0 20rpx rgba(255, 215, 0, 0.5));
}

.fortress-hp {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  background: rgba(0, 0, 0, 0.7);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.hp-label {
  font-size: 24rpx;
  color: #ff4444;
  font-weight: 600;
}

.hp-bar {
  width: 120rpx;
  height: 16rpx;
  background: #333;
  border-radius: 8rpx;
  overflow: hidden;
}

.hp-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff4444, #ff6666);
  transition: width 0.3s;
}

.hp-value {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

/* 敌人 */
.enemies {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.enemy {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.enemy.shooting {
  animation: shake 0.5s ease-in-out;
}

.enemy-emoji {
  font-size: 64rpx;
  filter: drop-shadow(0 0 10rpx rgba(255, 0, 0, 0.5));
}

.enemy-label {
  font-size: 20rpx;
  color: #ff4444;
  font-weight: 600;
  text-shadow: 0 0 8rpx rgba(255, 0, 0, 0.8);
}

/* 坦克 */
.tank {
  position: absolute;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 80rpx;
  filter: drop-shadow(0 0 15rpx rgba(0, 255, 0, 0.5));
  transition: left 0.3s;
}

.tank.moving {
  animation: tankMove 0.3s ease-in-out;
}

@keyframes tankMove {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-10rpx); }
}

/* 答题面板 */
.question-panel {
  flex: 1;
  background: #1a1a2e;
  padding: 24rpx;
}

.question-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.question-wave {
  font-size: 32rpx;
  color: #00ffff;
  font-weight: 600;
}

.question-score {
  font-size: 32rpx;
  color: #FFD700;
  font-weight: 600;
}

.question-box {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.2);
}

.question-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
  text-align: center;
}

.question-hint {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.options-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.option-turret {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.2);
  transition: all 0.3s;
}

.option-turret:active {
  transform: scale(0.95);
  background: rgba(0, 255, 255, 0.1);
}

.option-turret.correct {
  background: rgba(76, 175, 80, 0.2);
  border-color: #4CAF50;
}

.option-turret.wrong {
  background: rgba(244, 67, 54, 0.2);
  border-color: #F44336;
}

.turret-emoji {
  font-size: 48rpx;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

/* 攻击效果 */
.attack-effect {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  animation: fadeOut 0.5s ease-out;
}

.attack-emoji {
  font-size: 200rpx;
  animation: explode 0.5s ease-out;
}

@keyframes explode {
  0% { transform: scale(0); opacity: 1; }
  50% { transform: scale(1.5); opacity: 1; }
  100% { transform: scale(2); opacity: 0; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

/* 游戏结束 */
.game-over {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.over-content {
  width: 90%;
  max-width: 500rpx;
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 255, 255, 0.3);
}

.over-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  color: #fff;
}

.result-stats {
  margin-bottom: 40rpx;
}

.stat-box {
  padding: 32rpx;
  background: rgba(0, 255, 255, 0.1);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.3);
}

.stat-box .stat-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.stat-box .stat-value {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: #00ffff;
}

.stat-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}

.stat-item .stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.stat-item .stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.stat-value.correct {
  color: #4CAF50;
}

.stat-value.wrong {
  color: #F44336;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.restart-btn, .home-btn {
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.restart-btn {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  color: white;
}

.home-btn {
  background: rgba(255, 255, 255, 0.1);
  color: white;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.restart-btn:active, .home-btn:active {
  transform: scale(0.98);
}
